{
  "manifest_version": 3,
  "name": "Andar Status",
  "version": "1.0.0",
  "description": "Mostra no Andar qual app de trabalho você está usando (Figma, Notion, Google Docs...). Você escolhe quais aparecem.",
  "icons": { "16": "icone16.png", "32": "icone32.png", "48": "icone48.png", "128": "icone128.png" },
  "action": { "default_title": "Andar Status", "default_popup": "popup.html", "default_icon": { "16": "icone16.png", "32": "icone32.png" } },
  "background": { "service_worker": "fundo.js" },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "content_scripts": [{
    "matches": ["https://gather-next.vercel.app/*", "https://andar.app.br/*", "https://*.andar.app.br/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["ponte.js"], "run_at": "document_start"
  }]
}
