{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/agentes.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/agentes",
      "schedule": "0 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}