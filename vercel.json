{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/agentes.js": {
      "maxDuration": 60
    },
    "api/agentes-sala.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/agentes",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/agentes?acao=prospectar",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/relatorio",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/respostas",
      "schedule": "0 20 * * 1-5"
    },
    {
      "path": "/api/agentes-sala",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/conheca",
      "destination": "/landing"
    }
  ]
}